# ── server ──
PORT=4000
# MongoDB Atlas (Connect → Drivers → Node.js). Database: se_exit_exam
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/se_exit_exam?retryWrites=true&w=majority
# Folders the importer reads from (relative to repo root, one level up from mern-app)
CONTENT_NOTES_DIR=../notes
CONTENT_NEW_NOTES_DIR=../new_notes
CONTENT_QUIZ_DIR=../quiz/data
# Simple shared secret to guard the content-editing (admin) endpoints.
ADMIN_TOKEN=change-me-please
